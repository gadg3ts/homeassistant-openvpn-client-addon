#!/usr/bin/env bashio
set +u

OVPNFILE=$(bashio::config 'ovpnfile')
OPENVPN_CONFIG="/share/${OVPNFILE}"

bashio::log.info "Fixing permissions for ${OPENVPN_CONFIG}..."
# Ensure the file is readable
chmod 644 "${OPENVPN_CONFIG}" || bashio::log.warn "Could not chmod file"

# Initialize TUN interface
if [ ! -d /dev/net ]; then
    mkdir -p /dev/net
fi
if [ ! -c /dev/net/tun ]; then
    mknod /dev/net/tun c 10 200
fi

bashio::log.info "Starting OpenVPN..."
exec openvpn --config "${OPENVPN_CONFIG}" --cd /share